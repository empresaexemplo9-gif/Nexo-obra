# ---------------------------------------------------------------------------
# Integração financeira com a Drap — SOMENTE SERVIDOR.
# Nunca prefixe nenhuma destas variáveis com NEXT_PUBLIC_.
# Sem DRAP_API_URL e DRAP_API_TOKEN a tela mostra dados de demonstração,
# marcados como tal.
# ---------------------------------------------------------------------------
DRAP_API_URL=https://empresa.drap.app.br
DRAP_API_TOKEN=
# Vazio usa "Authorization: Bearer <token>". Informe um nome de header
# (ex.: X-API-Key) para enviar o token cru nele.
DRAP_API_KEY_HEADER=
# Contrato configurável de referência. NÃO é um endpoint confirmado pela Drap.
DRAP_SUMMARY_PATH=/api/v1/finance/summary
# Segredo compartilhado da verificação HMAC SHA-256 dos webhooks.
DRAP_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Identidade de desenvolvimento.
#
# Em produção a identidade vem dos headers da borda autenticada do host
# (ver lib/auth/identity.ts). Localmente, defina o e-mail abaixo para entrar
# sem o host. É ignorado quando NODE_ENV=production, a menos que
# NEXO_ALLOW_DEV_LOGIN=true seja definido explicitamente — não faça isso em
# um ambiente exposto: qualquer visitante entraria como este usuário.
# ---------------------------------------------------------------------------
NEXO_DEV_USER_EMAIL=
NEXO_DEV_USER_NAME=
