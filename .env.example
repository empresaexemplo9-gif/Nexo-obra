# Banco de dados (libSQL/Turso). Em produção, configure no painel do provedor de
# publicação — nunca no repositório. Em desenvolvimento, um arquivo local basta.
#   produção:        libsql://<banco>-<org>.turso.io
#   desenvolvimento: file:./local.db  (dispensa o token)
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Integração financeira Drap. Mantenha todos os segredos somente no servidor.
# DRAP_API_URL é a base técnica da API e NÃO deve receber /inicio.
DRAP_API_URL=https://empresa.drap.app.br

# Endereço HTTPS público desta instalação. É para cá que a Drap posta os eventos das
# empresas conectadas pela plataforma — o registro do webhook acontece sozinho ao
# conectar, e sem este endereço ele não tem destino. Na Vercel, o domínio de produção
# (VERCEL_PROJECT_PRODUCTION_URL) já serve; preencha quando houver domínio próprio.
HOIKOS_PUBLIC_URL=

# Compatibilidade para uma única empresa/tenant. A key oficial usa o formato
# drap_live_ + 32 caracteres e já isola o tenant no backend da Drap.
DRAP_API_TOKEN=
# Chave legada só opera nesta empresa explícita. Prefira provisionamento ou DRAP_TENANTS_JSON.
DRAP_LEGACY_COMPANY_ID=
DRAP_WEBHOOK_SECRET=

# Multiempresa: JSON indexado pelo external_company_id salvo em integration_connections.
# Configure no provedor de hospedagem, nunca no Git. Exemplo de formato:
# {"empresa-a":{"apiToken":"drap_live_...","webhookSecret":"..."},"empresa-b":{"apiToken":"drap_live_...","webhookSecret":"..."}}
DRAP_TENANTS_JSON=

# Bearer é o padrão oficial. Preencha somente se a Drap homologar outro header.
DRAP_API_KEY_HEADER=

# Endpoints confirmados têm defaults seguros. Sobrescreva somente se a própria Drap
# homologar outro caminho para o ambiente usado.
DRAP_SUMMARY_PATH=/api/v1/resumo
DRAP_TRANSACTIONS_PATH=/api/v1/lancamentos

# Cobranças, NFS-e e os demais recursos operacionais permitidos não usam rota manual de
# ambiente: a H.OIKOS descobre a rota real por tenant dentro de uma allowlist no servidor.

# Contratação embutida H.OIKOS → DRAP.
# A API pública atual não documenta provisionamento/checkout. Só configure quando a DRAP
# publicar e homologar uma rota service-to-service em empresa.drap.app.br. Novas ativações
# usam preço 1:1 com o catálogo DRAP, sem acréscimo da H.OIKOS.
DRAP_ACTIVATION_URL=
DRAP_ACTIVATION_TOKEN=
DRAP_ACTIVATION_WEBHOOK_SECRET=

# SINAPI via Orçamentador SDK/API (contrato do commit db5e9129446ec96c66341f0c323c20a8e52b265d).
# A URL, o header e o endpoint abaixo já são os defaults usados pelo código; somente o
# token é segredo e deve ser configurado na hospedagem, nunca no Git.
SINAPI_API_URL=https://orcamentador.com.br/api
SINAPI_API_TOKEN=
SINAPI_API_KEY_HEADER=X-API-Key
SINAPI_SEARCH_PATH=/insumos

# Armazenamento das fotos do diário (Vercel Blob). Sem ele, a foto responde 503 e o
# registro em texto continua salvo. Em testes automatizados, o armazenamento é injetado e
# nada sai pela rede; em produção não existe fallback local nem gravação em claro.
BLOB_READ_WRITE_TOKEN=

# Autoriza o cron diário que verifica se a competência SINAPI do mês anterior já precisa
# ser sincronizada. A atualização efetiva ocorre uma vez por competência mensal.
# Use um segredo aleatório com pelo menos 32 caracteres, somente na hospedagem.
CRON_SECRET=

# Cifra das fotos (AES-256-GCM), 32 bytes em base64: gere com `npm run media:key`.
# O Vercel Blob publica cada objeto numa URL aleatória e não tem leitura assinada, então o
# conteúdo sobe cifrado — uma URL vazada devolve bytes inúteis. Sem esta chave, nenhuma foto
# é gravada: subir em claro não deve acontecer por omissão. Trocá-la torna ilegíveis as
# fotos já gravadas; o texto dos registros continua intacto.
MEDIA_ENCRYPTION_KEY=

# Sessão das contas da plataforma. Pelo menos 32 caracteres aleatórios; trocar o valor
# invalida todas as sessões abertas. Sem ele, nenhum login da empresa funciona.
SESSION_SECRET=

# Confiar nos cabeçalhos `oai-authenticated-user-*` como identidade. Só faz sentido atrás
# de uma borda que os sobrescreva em toda requisição. Em qualquer outra hospedagem deixe
# vazio: qualquer visitante pode enviar esses cabeçalhos e se passar por outra pessoa.
TRUST_IDENTITY_HEADERS=

# Superadmin credentials stay server-side. Generate a PBKDF2-SHA256 hash; never commit a password.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD_HASH=
SUPERADMIN_SESSION_SECRET=

# Isolated company-side maintenance administrator. Keep the password hash and session secret in hosting secrets.
MAINTENANCE_ADMIN_EMAIL=
MAINTENANCE_ADMIN_PASSWORD_HASH=
MAINTENANCE_ADMIN_SESSION_SECRET=
