# Banco de dados (libSQL/Turso). Em produção, configure no painel do provedor de
# publicação — nunca no repositório. Em desenvolvimento, um arquivo local basta.
#   produção:        libsql://<banco>-<org>.turso.io
#   desenvolvimento: file:./local.db  (dispensa o token)
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Remote financial integration. Keep these values server-side.
DRAP_API_URL=https://empresa.drap.app.br
DRAP_API_TOKEN=
DRAP_API_KEY_HEADER=
DRAP_SUMMARY_PATH=/api/v1/finance/summary
DRAP_TRANSACTIONS_PATH=
DRAP_CHARGES_PATH=
DRAP_WEBHOOK_SECRET=

# Subscription activation: separate service token and HMAC secret, server-side only.
# Set the full URL only after implementing/homologating the Empresa endpoint described in docs/DRAP-ACTIVATION.md.
DRAP_ACTIVATION_URL=
DRAP_ACTIVATION_TOKEN=
DRAP_ACTIVATION_WEBHOOK_SECRET=

# Official SINAPI provider. Keep credentials server-side; no demo prices are used.
SINAPI_API_URL=
SINAPI_API_TOKEN=
SINAPI_API_KEY_HEADER=
SINAPI_SEARCH_PATH=/items/search

# Superadmin credentials stay server-side. Generate a PBKDF2-SHA256 hash; never commit a password.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD_HASH=
SUPERADMIN_SESSION_SECRET=

# Isolated company-side maintenance administrator. Keep the password hash and session secret in hosting secrets.
MAINTENANCE_ADMIN_EMAIL=
MAINTENANCE_ADMIN_PASSWORD_HASH=
MAINTENANCE_ADMIN_SESSION_SECRET=
